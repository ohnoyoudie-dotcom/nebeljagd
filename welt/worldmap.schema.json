{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nebeljagd:worldmap:schema:1",
  "title": "Nebeljagd – editierbare Kartenbasis v1",
  "description": "Strukturelles Format der editierbaren Nebeljagd-Welt. Ein Meter entspricht einer Welteinheit. Semantische Geometrie- und Spielregeln prüft src/map/model.js; objects enthält alle platzierten 3D-Objekte.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "coordinateSystem",
    "bounds",
    "gameplay",
    "island",
    "regions",
    "paths",
    "rivers",
    "places",
    "spawnAreas",
    "zone"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "coordinateSystem": {
      "type": "object",
      "required": [
        "units",
        "horizontalAxes",
        "north",
        "metersPerUnit"
      ],
      "properties": {
        "units": {
          "const": "meters"
        },
        "horizontalAxes": {
          "const": [
            "x",
            "z"
          ]
        },
        "north": {
          "const": "-z"
        },
        "metersPerUnit": {
          "const": 1
        }
      }
    },
    "bounds": {
      "type": "object",
      "required": [
        "minX",
        "minZ",
        "maxX",
        "maxZ"
      ],
      "properties": {
        "minX": {
          "type": "number"
        },
        "minZ": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "maxZ": {
          "type": "number"
        }
      }
    },
    "gameplay": {
      "type": "object",
      "required": [
        "targetPlayers",
        "walkSpeedMetersPerSecond"
      ],
      "properties": {
        "targetPlayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "walkSpeedMetersPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "spawnPosition": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "island": {
      "$ref": "#/$defs/island"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "rivers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/river"
      }
    },
    "places": {
      "type": "array",
      "minItems": 0,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "spawnAreas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/spawn"
      }
    },
    "zone": {
      "type": "object",
      "required": [
        "center",
        "initialRadius",
        "phases",
        "damagePerSecond"
      ],
      "properties": {
        "center": {
          "$ref": "#/$defs/point"
        },
        "initialRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "damagePerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 12000,
      "items": {
        "$ref": "#/$defs/worldObject"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "island": {
      "type": "object",
      "required": [
        "id",
        "name",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "name",
        "biome",
        "color",
        "points",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "biome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "label": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "path": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "width",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "main",
            "trail",
            "bridge"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "river": {
      "type": "object",
      "required": [
        "id",
        "name",
        "width",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "village",
            "ruin",
            "shrine",
            "landmark",
            "harbor"
          ]
        },
        "position": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "spawn": {
      "type": "object",
      "required": [
        "id",
        "name",
        "position",
        "radius",
        "capacity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "name",
        "holdSeconds",
        "shrinkSeconds",
        "radius"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "holdSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 7200
        },
        "shrinkSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 7200
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      }
    },
    "worldObject": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "variant",
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "tree",
            "house",
            "flower",
            "grass",
            "rock",
            "mound",
            "bush",
            "ruin",
            "shrine",
            "heart",
            "chest",
            "bow",
            "sword",
            "fireStaff",
            "iceStaff",
            "wall",
            "fence",
            "crate"
          ]
        },
        "variant": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "rotation": {
          "type": "number",
          "minimum": -62.83185307179586,
          "maximum": 62.83185307179586,
          "description": "Drehung um die vertikale Y-Achse in Radiant."
        },
        "scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "radius": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 100
        },
        "depth": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 100
        },
        "rarity": {
          "enum": [
            "normal",
            "common",
            "uncommon",
            "rare",
            "legendary"
          ],
          "description": "Waffenstufe; ältere Karten ohne Stufe erhalten common beim Import."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tree"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "oak",
                  "birch",
                  "pine",
                  "rei-tree01",
                  "rei-tree02"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "house"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "herbal",
                  "inn",
                  "hunter"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "flower"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "rei-white",
                  "rei-red",
                  "rei-gold"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grass"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "tall",
                  "short"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rock"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "granite",
                  "basalt"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mound"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "ridge",
                  "knoll"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bush"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "rei-bush"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ruin"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "stone"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shrine"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "magic"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heart"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "healing"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "chest"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "wood"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bow"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "wood"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sword"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "steel"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "grass",
                  "flower"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "radius"
            ],
            "properties": {
              "radius": {
                "minimum": 0.5,
                "maximum": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fireStaff"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "ember"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "iceStaff"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variant": {
                "enum": [
                  "frost"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "rarity"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "bow",
                  "sword",
                  "fireStaff",
                  "iceStaff"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
